# Copia este archivo como .env y ajusta los valores.
PORT=3000
NODE_ENV=development

# postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/tienda

# Cadena aleatoria de al menos 32 caracteres. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria_de_32+
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Credenciales del administrador que crea `npm run db:seed`
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin123!

# Base de datos SOLO para pruebas (npm test la borra y recrea)
TEST_DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/tienda_test
